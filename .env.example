# =============================================================================
# kosha environment configuration
# =============================================================================
#
# Copy this file to `.env` in the project root and adjust the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
#
# How values are resolved (config/settings.py):
#   1. Variables already set in the process environment win.
#   2. Otherwise the value from `.env` is used.
#   3. Otherwise the default in settings.py applies. Defaults are chosen to be
#      safe for production, so a missing variable fails closed, not open.
#
# Format notes:
#   - One KEY=value per line, no spaces around `=`.
#   - Booleans accept true/false, yes/no, on/off, 1/0 (case-insensitive).
#   - Lists are comma-separated, without spaces: a,b,c
#   - Inline comments are NOT supported. A `#` after a value becomes part of
#     the value, so keep comments on their own lines.
#   - Special characters inside URLs (passwords especially) must be
#     percent-encoded, e.g. `@` -> %40, `:` -> %3A, `/` -> %2F, `#` -> %23.
#
# Values below are suitable for local development.


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# SECRET_KEY  (required, no default)
# Signs sessions, password reset tokens, CSRF tokens and anything else that
# uses django.core.signing. Must be long, random and unique per environment.
# Rotating it logs every user out and invalidates outstanding reset links.
# Generate one with:
#     uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# DEBUG  (default: false)
# Shows detailed error pages with source code and settings, and serves static
# files straight from app directories. Never enable in production: it leaks
# secrets and source to anyone who triggers an error.
# Turning DEBUG on also relaxes the HTTPS defaults in the Security section.
DEBUG=true

# ALLOWED_HOSTS  (default: empty)
# Comma-separated host/domain names this site may serve. Requests with any
# other Host header get a 400. A leading dot matches subdomains
# (.example.com matches example.com and www.example.com). `*` allows any
# host and should only be used behind a proxy that validates Host itself.
# When DEBUG is true and this is empty, localhost, 127.0.0.1 and [::1] are
# allowed automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS  (default: empty)
# Comma-separated origins (scheme + host [+ port]) trusted for unsafe requests
# (POST, PUT, DELETE...). Needed when the site is reached over HTTPS through a
# proxy, or when forms are submitted from another subdomain.
# Example: https://kosha.example.com,https://*.example.com
CSRF_TRUSTED_ORIGINS=


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# DATABASE_URL  (default: SQLite file at <project root>/db.sqlite3)
# Database connection as a URL. Examples:
#
#   SQLite, relative to the working directory:  sqlite:///db.sqlite3
#   SQLite, absolute path (note four slashes):  sqlite:////var/lib/kosha/db.sqlite3
#   SQLite, in memory:                          sqlite://:memory:
#   PostgreSQL:                                 postgres://USER:PASSWORD@HOST:5432/NAME
#   MySQL:                                      mysql://USER:PASSWORD@HOST:3306/NAME
#
# PostgreSQL needs `psycopg` installed, MySQL needs `mysqlclient`.
#
# Connection options go in the query string. These map to top-level Django
# DATABASES keys:
#   conn_max_age=600          keep connections open for N seconds (0 = close
#                             after each request, empty = forever)
#   conn_health_checks=true   check persistent connections before reuse
#   atomic_requests=true      wrap each request in a transaction
# Anything else is passed to the driver in OPTIONS, e.g. sslmode=require.
#
#   postgres://kosha:secret@db:5432/kosha?conn_max_age=600&sslmode=require
#
# Leave commented out to use the default SQLite file. Relative SQLite paths
# resolve against the working directory, not the project root.
# DATABASE_URL=postgres://kosha:secret@localhost:5432/kosha


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# CACHE_URL  (default: locmemcache://)
# Cache backend as a URL. Examples:
#
#   Per-process memory (default):  locmemcache://
#   Disabled (no-op):              dummycache://
#   Filesystem:                    filecache:///var/tmp/kosha_cache
#   Database table:                dbcache://kosha_cache_table
#                                  (then run: uv run manage.py createcachetable)
#   Redis:                         rediscache://HOST:6379/1
#   Memcached (pymemcache):        pymemcache://HOST:11211
#
# Local memory is fine for development but is not shared between worker
# processes, so use Redis or Memcached when running more than one worker.
CACHE_URL=locmemcache://


# -----------------------------------------------------------------------------
# Internationalization
# -----------------------------------------------------------------------------

# LANGUAGE_CODE  (default: en-us)
# Default language for the site, as a language tag (en-us, en-gb, hi, ...).
LANGUAGE_CODE=en-us

# TIME_ZONE  (default: UTC)
# IANA time zone name used for displaying dates and in forms. Datetimes are
# always stored in UTC regardless of this value.
# Examples: UTC, Asia/Kolkata, Europe/London, America/New_York
TIME_ZONE=UTC


# -----------------------------------------------------------------------------
# Static files (served by WhiteNoise)
# -----------------------------------------------------------------------------
#
# WhiteNoise serves static files directly from the Django process, compressed
# and with far-future cache headers, so no separate web server is needed for
# them. In production run `uv run manage.py collectstatic --noinput` on every
# deploy; it copies files to STATIC_ROOT and writes the hashed-filename
# manifest WhiteNoise relies on.

# STATIC_URL  (default: static/)
# URL prefix static files are served under. Set to a full URL
# (https://cdn.example.com/static/) when fronting WhiteNoise with a CDN.
STATIC_URL=static/

# STATIC_ROOT  (default: <project root>/staticfiles)
# Absolute directory `collectstatic` writes to and WhiteNoise serves from.
# Leave commented out to use the default. An empty value means the current
# working directory, which is never what you want.
# STATIC_ROOT=/var/www/kosha/static


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# EMAIL_URL  (default: consolemail://)
# Where outgoing email goes, as a URL. Examples:
#
#   Print to the console (dev):       consolemail://
#   Write to files in a directory:    filemail:////absolute/path/to/dir
#   Keep in memory (tests):           memorymail://
#   Discard:                          dummymail://
#   SMTP, plain:                      smtp://USER:PASSWORD@HOST:25
#   SMTP with STARTTLS (port 587):    smtp+tls://USER:PASSWORD@HOST:587
#   SMTP over implicit TLS (465):     smtp+ssl://USER:PASSWORD@HOST:465
#
# Usernames are often email addresses, so percent-encode the `@`:
#   smtp+tls://apikey%40example.com:s3cret@smtp.example.com:587
EMAIL_URL=consolemail://

# DEFAULT_FROM_EMAIL  (default: webmaster@localhost)
# Sender address for regular email (password resets, notifications).
# Accepts "Display Name <address@example.com>".
DEFAULT_FROM_EMAIL=webmaster@localhost

# SERVER_EMAIL  (default: root@localhost)
# Sender address for error reports mailed to ADMINS.
SERVER_EMAIL=root@localhost

# ADMINS  (default: empty)
# Comma-separated email addresses that receive a full traceback whenever the
# site raises a 500 error while DEBUG is false.
# Example: ops@example.com,you@example.com
ADMINS=


# -----------------------------------------------------------------------------
# Security / HTTPS
# -----------------------------------------------------------------------------
#
# SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE default to
# the opposite of DEBUG: off in development, on in production. They are left
# commented out below so that flipping DEBUG is enough; only set them to
# override that, e.g. when a proxy already redirects to HTTPS.
#
# Run `uv run manage.py check --deploy` against production settings to catch
# anything missed.

# SECURE_PROXY_SSL_HEADER  (default: false)
# Set to true when Django runs behind a reverse proxy or load balancer that
# terminates TLS and sets `X-Forwarded-Proto: https`. Without it Django thinks
# every request is plain HTTP, and SECURE_SSL_REDIRECT loops forever.
# Only enable it if the proxy strips this header from incoming client
# requests; otherwise clients can spoof HTTPS.
SECURE_PROXY_SSL_HEADER=false

# SECURE_SSL_REDIRECT  (default: true when DEBUG is false)
# Redirect every HTTP request to HTTPS. Turn off if the proxy already does it.
# SECURE_SSL_REDIRECT=true

# SESSION_COOKIE_SECURE  (default: true when DEBUG is false)
# Only send the session cookie over HTTPS. Logging in over plain
# http://localhost needs this off.
# SESSION_COOKIE_SECURE=true

# CSRF_COOKIE_SECURE  (default: true when DEBUG is false)
# Only send the CSRF cookie over HTTPS. Submitting forms over plain
# http://localhost needs this off.
# CSRF_COOKIE_SECURE=true

# SECURE_HSTS_SECONDS  (default: 0, disabled)
# Sends Strict-Transport-Security, telling browsers to refuse plain HTTP for
# this many seconds. Browsers cache this, so a mistake locks users out for
# the whole duration. Roll out gradually: 60, then 3600, then 31536000.
SECURE_HSTS_SECONDS=0

# SECURE_HSTS_INCLUDE_SUBDOMAINS  (default: false)
# Extend HSTS to every subdomain. Only enable once all subdomains serve HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# SECURE_HSTS_PRELOAD  (default: false)
# Mark the domain as eligible for browsers' built-in HSTS preload lists.
# Requires SECURE_HSTS_SECONDS >= 31536000 and INCLUDE_SUBDOMAINS. Removal
# from the preload lists takes months, so treat this as permanent.
SECURE_HSTS_PRELOAD=false


# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
#
# Read by compose.yaml and compose.prod.yaml, not by Django. Compose also
# interpolates this file and warns about any `$` in values (e.g. in
# SECRET_KEY); the warning is harmless, containers receive the value verbatim.

# DOCKER_UID / DOCKER_GID  (default: 1000)
# Dev containers run as this user so files they write into the working tree
# stay yours. Set to the output of `id -u` / `id -g` if not 1000.
# DOCKER_UID=1000
# DOCKER_GID=1000

# DOCKER_HOST_PORT  (default: 8000)
# Host port the app is published on. Prod binds it to 127.0.0.1 only.
# DOCKER_HOST_PORT=8000

# DOCKER_IMAGE / DOCKER_IMAGE_TAG  (default: kosha / latest)
# Image compose.prod.yaml builds or pulls.
# DOCKER_IMAGE=kosha
# DOCKER_IMAGE_TAG=latest

# DOCKER_CPU_LIMIT / DOCKER_MEMORY_LIMIT  (default: 1.0 / 512m)
# Ceiling for the prod django container.
# DOCKER_CPU_LIMIT=1.0
# DOCKER_MEMORY_LIMIT=512m

# GUNICORN_WORKERS / GUNICORN_THREADS  (default: 2 / 4)
# Prod concurrency is workers x threads. See docker/gunicorn.conf.py for the
# remaining GUNICORN_* knobs.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
